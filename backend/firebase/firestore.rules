rules_version = '2';

// All data access goes through the FastAPI backend, which uses the Firebase Admin SDK
// (Admin SDK calls bypass these rules) and checks the staff login itself
// (app/api/deps.py: require_staff). The browser never reads or writes Firestore
// directly -- it only uses Firebase Auth to sign in -- so every client request is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
