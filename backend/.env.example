# --- OpenAI ---
OPENAI_API_KEY=

# --- Gmail API (OAuth Desktop/Web client) ---
# Path to the OAuth client secret JSON downloaded from Google Cloud Console
# (APIs & Services > Credentials > OAuth 2.0 Client ID > Desktop app)
GMAIL_OAUTH_CLIENT_SECRET_FILE=./credentials/gmail_client_secret.json
# Path where the generated user token (after first interactive auth) is cached
GMAIL_OAUTH_TOKEN_FILE=./credentials/gmail_token.json
# Production (Railway) alternative to the two file paths above: the actual
# *contents* of gmail_client_secret.json / gmail_token.json, pasted in whole.
# Railway's filesystem doesn't persist the credentials/ folder across deploys
# and there's no browser to complete an interactive OAuth flow on a headless
# server -- run the flow once locally (USE_MOCK_INTEGRATIONS=false there),
# then paste both files' contents in here. Leave blank for local dev.
GMAIL_OAUTH_CLIENT_SECRET_JSON=
GMAIL_OAUTH_TOKEN_JSON=
# The mailbox this pipeline sends from / reads replies from.
# Testing: a developer's own Gmail. Production: swap to the company mailbox
# (same OAuth app, just re-run the auth flow against that account).
GMAIL_SENDER_ADDRESS=

# --- Firebase (Firestore data + Firebase Auth staff login) ---
# Firebase console > Project settings > Service accounts > Generate new private key.
# Production (Railway): paste the whole JSON file's contents into FIREBASE_SERVICE_ACCOUNT_JSON.
# Local dev: point FIREBASE_SERVICE_ACCOUNT_FILE at the downloaded file instead.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=
# Prepended to every Firestore collection name (e.g. "test_") so local testing can share a
# project without touching real data. Leave empty in production.
FIRESTORE_COLLECTION_PREFIX=
# REQUIRED outside development: comma-separated staff emails allowed into the dashboard API.
# (A Firebase login alone is not enough -- anyone with the public web API key can try to sign up.)
STAFF_EMAIL_ALLOWLIST=

# --- Company research (optional; free tier is 1,000 searches a month) ---
# Without a key, research still works from the lead's email domain.
TAVILY_API_KEY=

# --- Company info (used in email footers per CAN-SPAM, §8) ---
COMPANY_NAME=VRT Management Group, LLC
COMPANY_ADDRESS=1 Botsford Hill Road, PO Box 150, Botsford, CT 06404
COMPANY_NOTIFICATION_EMAIL=

# --- Sending controls (§8) ---
DAILY_SEND_CAP=30
FOLLOW_UP_WAIT_DAYS=3
MAX_FOLLOW_UPS=3

# --- Models (§6) ---
DRAFTING_MODEL=gpt-4o-mini
CLASSIFICATION_MODEL=gpt-4o-mini
CHATBOT_MODIFICATION_MODEL=gpt-4o

# --- App ---
ENVIRONMENT=development
# When true, pipeline uses in-memory/mock Gmail + Firestore instead of live APIs.
# Useful for the synthetic-lead test pass in CLAUDE.md §13.1 before real creds are live.
USE_MOCK_INTEGRATIONS=true

# The deployed frontend's origin(s), comma-separated -- required once
# ENVIRONMENT is anything other than "development", or every request from
# the Vercel frontend gets rejected by CORS before it reaches a route.
# e.g. https://vrt-leads.vercel.app
ALLOWED_ORIGINS=

# Public URL this API is reachable at -- used to build the unsubscribe link
# that goes out in every email (§8). localhost in dev; the real Railway URL
# once deployed (§11).
PUBLIC_BASE_URL=http://localhost:8000
# Signs unsubscribe links. Set a fixed value in any real environment -- if
# left blank a random one is generated per process start, which invalidates
# every previously-sent unsubscribe link on restart.
UNSUBSCRIBE_SECRET=

# --- Background reply/bounce polling (§6.7, §8) ---
# How often (seconds) the server checks Gmail for new replies/bounces on its
# own, instead of relying on staff clicking "Check replies". Minutes-scale,
# not seconds -- polling faster costs effectively nothing extra (the poll
# fetches the same bounded recent-messages window either way, and the LLM
# only runs when a genuinely new reply is found), but replies aren't
# time-sensitive enough to justify sub-minute polling either. Set to 0 to
# disable and rely on the manual button / an external scheduler only.
AUTO_TICK_INTERVAL_SECONDS=180
